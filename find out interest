#include <iostream>
using namespace std;
int main() {
    float P, T, R, SI;
    cout << "Enter Principal: ";
    cin >> P;
    cout << "Enter Time (in years): ";
    cin >> T;
    cout << "Enter Rate of Interest: ";
    cin >> R;
    SI = (P * T * R) / 100;
    cout << "Simple Interest = " << SI << endl;
    return 0;
}
