#include <iostream>
using namespace std;

int main() {
    int m1, m2, m3, m4, m5;
    float average;

    // Background color (blue) & text color (white)
    cout << "\033[44;37m";

    cout << "=====================================\n";
    cout << "      STUDENT AVERAGE CALCULATOR      \n";
    cout << "=====================================\n";

    cout << " Enter marks of 5 subjects \n";
    cout << "-------------------------------------\n";

    cout << " Subject 1: ";
    cin >> m1;
    cout << " Subject 2: ";
    cin >> m2;
    cout << " Subject 3: ";
    cin >> m3;
    cout << " Subject 4: ";
    cin >> m4;
    cout << " Subject 5: ";
    cin >> m5;

    average = (m1 + m2 + m3 + m4 + m5) / 5.0;

    cout << "-------------------------------------\n";
    cout << " Average Marks = " << average << endl;
    cout << "=====================================\n";

    // Reset color
    cout << "\033[0m";

    return 0;
}
