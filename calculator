 switch (choice) {
        case 1:
            cout << num1 << " + " << num2 << " = " << add(num1, num2);
            break;

        case 2:
            cout << num1 << " - " << num2 << " = " << sub(num1, num2);
            break;

        case 3:
            cout << num1 << " * " << num2 << " = " << mul(num1, num2);
            break;

        case 4:
            if (num2 != 0)
                cout << num1 << " / " << num2 << " = " << divi(num1, num2);
            else
                cout << "Error: Divide by zero";
            break;

        default:
            cout << "Invalid choice";
    }

    cout << "\n==============================\n";
    return 0;
}
