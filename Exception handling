
#include <iostream>
using namespace std;

int main() {
    float num, den, result;

    cout << "Enter numerator: ";
    cin >> num;
    cout << "Enter denominator: ";
    cin >> den;

    try {
        // Check if denominator is zero
        if (den == 0) {
            throw "Division by zero error!"; // Throwing an exception
        }
        
        result = num / den;
        cout << "Result: " << result << endl;
    } 
    catch (const char* msg) {
        // Catching the exception and displaying the message
        cout << "Error: " << msg << endl;
    }

    return 0;
}
