caclulate compound interest 
#include <iostream>
#include <cmath>
using namespace std;
int main() {
    float P, R, T, CI, amount;
    cout << "Enter Principal: ";
    cin >> P;
    cout << "Enter Rate of Interest: ";
    cin >> R;
    cout << "Enter Time (in years): ";
    cin >> T;
    amount = P * pow((1 + R / 100), T);
    CI = amount - P;
    cout << "Compound Interest = " << CI << endl;
    return 0;
}
